{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "types": [],
    "lib": ["ES2020", "DOM"],
    "paths": {
      "@bid-king/shared": ["../shared/src/index.ts"],
      "@bid-king/shared/*": ["../shared/src/*"],
      "cc": ["./temp/declarations/cc"],
      "cc/env": ["./temp/declarations/cc.env"]
    },
    "rootDirs": ["assets/scripts", "../shared/src"]
  },
  "include": ["assets/scripts/**/*", "../shared/src/**/*", "temp/declarations/**/*.d.ts"],
  "exclude": ["library", "local", "build", "profiles", "node_modules"]
}
